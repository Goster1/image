{
  "name": "video-kontrola-pracovnikov",
  "private": true,
  "version": "0.1.0",
  "description": "Chrome MV3 extension: camera-based verification that warehouse workers place scanned products on the instructed side (left/right/behind).",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/fetch-model.mjs",
    "build": "vite build && vite build -c vite.content.config.ts",
    "demo": "vite demo-wms --port 5173 --strictPort",
    "test": "vitest run",
    "fetch-model": "node scripts/fetch-model.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14"
  }
}
