{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["chrome", "vite/client", "node"]
  },
  "include": ["extension/src", "demo-wms", "scripts"]
}
